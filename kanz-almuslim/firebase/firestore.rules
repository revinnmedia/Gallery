rules_version = '2';

// قواعد حماية قاعدة بيانات كنز المسلم.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }

    // ملف المستخدم ونقاطه. الكل يقرأ (للترتيب)، والمالك فقط يكتب.
    match /users/{uid} {
      allow read: if signedIn();

      allow create: if isMe(uid)
        && request.resource.data.total == 0
        && validProfile();

      // النقاط تزيد فقط، وبحد أقصى ٢٠٠٠ في كل تحديث (يمنع التلاعب السهل).
      allow update: if isMe(uid)
        && validProfile()
        && request.resource.data.get('total', 0) >= resource.data.get('total', 0)
        && request.resource.data.get('total', 0) - resource.data.get('total', 0) <= 2000
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['code'])
            || existsAfter(/databases/$(database)/documents/codes/$(request.resource.data.code)));

      allow delete: if isMe(uid);

      function validProfile() {
        let d = request.resource.data;
        return d.name is string && d.name.size() > 0 && d.name.size() <= 30
          && d.get('total', 0) is int
          && d.get('dayCount', 0) is int && d.get('dayCount', 0) <= d.get('total', 0)
          && d.get('weekCount', 0) is int && d.get('weekCount', 0) <= d.get('total', 0)
          && d.get('monthCount', 0) is int && d.get('monthCount', 0) <= d.get('total', 0);
      }
    }

    // رموز الصداقة: رمز -> مستخدم.
    match /codes/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && code.size() == 6;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // طلبات الصداقة: المعرّف = from_to
    match /friendRequests/{id} {
      allow read: if signedIn()
        && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      // update يسمح بإعادة إرسال نفس الطلب.
      allow create, update: if signedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to
        && request.resource.data.fromName is string
        && request.resource.data.fromName.size() <= 30
        // رسالة دعوة المنافسة (آية + كلمة اختيارية).
        && (!('message' in request.resource.data)
            || (request.resource.data.message is string
                && request.resource.data.message.size() <= 300));
      allow delete: if signedIn()
        && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
    }

    // الصداقة بين شخصين: المعرّف = الأصغر_الأكبر
    match /friendships/{pairId} {
      function members() { return resource.data.members; }

      allow read: if signedIn() && request.auth.uid in members();

      // تُنشأ فقط من الطرف الذي استقبل طلباً موجوداً.
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2
        && exists(/databases/$(database)/documents/friendRequests/$(request.resource.data.request))
        && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.request)).data.to == request.auth.uid
        && get(/databases/$(database)/documents/friendRequests/$(request.resource.data.request)).data.from in request.resource.data.members;

      allow delete: if signedIn() && request.auth.uid in members();

      // المحادثة بين الصديقين فقط.
      match /messages/{msgId} {
        function pair() { return get(/databases/$(database)/documents/friendships/$(pairId)).data.members; }
        allow read: if signedIn() && request.auth.uid in pair();
        allow create: if signedIn() && request.auth.uid in pair()
          && request.resource.data.from == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
      }
    }
  }
}
